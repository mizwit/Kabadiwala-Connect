<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".auth.RegistrationActivity">

    <!-- Step 1: Initial Registration -->
    <TextView
        android:id="@+id/headingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="147dp"
        android:layout_marginTop="280dp"
        android:layout_marginEnd="147dp"
        android:fontFamily="sans-serif-black"
        android:text="Registration"
        android:textColor="#1E781E"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/nameEditText"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#E8F5E9"
        android:ems="10"
        android:gravity="center"
        android:hint="Name"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#2E7D32"
        android:textColorHint="#81C784"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headingText"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/phoneEditText"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#E8F5E9"
        android:ems="10"
        android:hint="Mobile Number"
        android:inputType="phone"
        android:padding="12dp"
        android:gravity="center"
        android:textColorHint="#81C784"
        android:textColor="#2E7D32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameEditText"
        tools:ignore="DuplicateClickableBoundsCheck" />

    <Button
        android:id="@+id/sendOtpButton"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginStart="65dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="60dp"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:backgroundTint="#A03CA0"
        android:radius="25dp"
        android:text="Sign Up"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneEditText"
        tools:ignore="DuplicateSpeakableTextCheck,UnknownId" />

    <TextView
        android:id="@+id/loginLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="147dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="147dp"
        android:text="Already have an account? Login"
        android:textSize="16sp"
        android:textColor="#4CAF50"
        android:clickable="true"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendOtpButton" />

    <!-- Step 2: OTP Verification (Initially Hidden) -->
    <EditText
        android:id="@+id/otpEditText"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#E8F5E9"
        android:ems="10"
        android:gravity="center"
        android:hint="Enter OTP"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="#1E781E"
        android:textColorHint="#81C784"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headingText"
        tools:ignore="TextContrastCheck" />

    <Button
        android:id="@+id/verifyOtpButton"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginStart="65dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="60dp"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:backgroundTint="#A03CA0"
        android:radius="25dp"
        android:text="Verify OTP"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpEditText"
        tools:ignore="DuplicateSpeakableTextCheck,UnknownId" />

    <!-- Step 3: PIN Creation (Initially Hidden) -->
    <EditText
        android:id="@+id/pinEditText"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#E8F5E9"
        android:ems="10"
        android:hint="Create 4-digit PIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="12dp"
        android:gravity="center"
        android:textColorHint="#81C784"
        android:textColor="#2E7D32"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameEditText" />

    <EditText
        android:id="@+id/confirmPinEditText"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="56dp"
        android:background="@android:drawable/alert_light_frame"
        android:backgroundTint="#E8F5E9"
        android:ems="10"
        android:hint="Confirm PIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="12dp"
        android:gravity="center"
        android:textColorHint="#81C784"
        android:textColor="#2E7D32"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pinEditText" />

    <Button
        android:id="@+id/completeRegistrationButton"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginStart="65dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="60dp"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:backgroundTint="#A03CA0"
        android:radius="25dp"
        android:text="Register"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmPinEditText"
        tools:ignore="DuplicateSpeakableTextCheck,UnknownId" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/completeRegistrationButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>